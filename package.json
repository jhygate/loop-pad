{
  "name": "loop-pad",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "http-server . -p 8009",
    "dev": "concurrently \"tsc --watch\" \"http-server . -p 8009\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "http-server": "^14.1.1",
    "typescript": "^6.0.2"
  }
}
